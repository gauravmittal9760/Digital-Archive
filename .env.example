# ---- core ----
APP_ENV=development            # production on the server
SECRET_KEY=change-me-long-random-string
PUBLIC_BASE_URL=
MAX_CONTENT_LENGTH_MB=110
USER_STORAGE_QUOTA_MB=500

# ---- database (Neon) ----
DATABASE_URL=
# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Brevo e-mail (OTP mails are sent as "Digital Archive") ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=            # a sender verified in your Brevo account (required)
BREVO_SENDER_NAME=Digital Archive

# ---- optional FREE image AI (Google AI Studio key, no card needed) ----
GEMINI_API_KEY=
ENABLE_OCR=            # true only if tesseract is installed

# ---- admin panel (hidden) ----
ADMIN_USERNAME=                # typed on the normal login page to open the gateway
ADMIN_PASSWORD=                # typed on the normal login page together with ADMIN_USERNAME
ADMIN_PANEL_PASSWORD=          # asked on the "Login to Admin Panel" step
ADMIN_EMAIL=                   # receives admin recovery codes
ADMIN_SECURITY_QUESTION=
ADMIN_SECURITY_ANSWER=

# ---- scheduler for trash auto-delete when the site sleeps ----
CRON_SECRET=                   # any long random string
