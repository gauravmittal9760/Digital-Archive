# Copy this file to .env and fill in your own values. Never commit .env.
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
SECRET_KEY=replace-with-a-long-random-secret
# Local: sqlite is fine. Online (Neon): paste the normal "postgresql://...neon.tech/neondb?sslmode=require" URL - the app switches to the pure-Python pg8000 driver by itself.
DATABASE_URL=sqlite:///digital_archive.db
PUBLIC_BASE_URL=http://127.0.0.1:5000
MAX_CONTENT_LENGTH_MB=110

# Cloudinary (required for production; optional for local disk development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo email (optional locally; required for real email delivery)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Digital Archive

# Optional Gemini vision
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local/Render Tesseract OCR. Windows default install path is usually already on PATH.
ENABLE_OCR=true
TESSERACT_CMD=tesseract

# Admin credentials: use strong, unique values before deployment
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PANEL_PASSWORD=
ADMIN_EMAIL=
ADMIN_SECURITY_QUESTION=What is your admin recovery phrase?
ADMIN_SECURITY_ANSWER=

# Scheduled trash cleanup
CRON_SECRET=

# Optional limits
USER_STORAGE_QUOTA_MB=500
TRASH_RETENTION_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_HOURLY_LIMIT=5

# Lifetime window for media links (minutes). Links stay valid between 1x and 2x this value.
MEDIA_URL_TTL_MINUTES=30
